<!--This file is generated by AI.-->
<!--Claude Opus 5.5-->
<!--"Make StartupWindow UI: left = create, right = open, the hovered side grows" (chat 2026-10-13)-->
<!--Split animation simplified to element EventTriggers (style triggers got stuck after two swipes)-->
<Window x:Class="NightfallEditor.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NightfallEditor.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Width="800"
        Height="600"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window.Background}"
        Foreground="{StaticResource Brush.Text}"
        Title="Nightfall">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!--
        Bindings this window expects on its DataContext (StartupViewModel):

          Templates            IEnumerable   items with Name (string)
          SelectedTemplate     object        two-way
          NewProjectName       string        two-way
          NewProjectLocation   string        two-way
          NewProjectPathPreview string       e.g. D:\Projects\MyGame\MyGame.nfproj
          NewProjectError      string?       null/empty = no error
          BrowseLocationCommand ICommand
          CreateCommand        ICommand      CanExecute = input is valid

          RecentProjects       IEnumerable   items with Name, Path (string),
                                             LastOpened (DateTime), IsMissing (bool)
          OpenRecentCommand    ICommand      parameter = recent project item
          OpenExistingCommand  ICommand      file picker for *.nfproj
    -->

    <Window.Resources>

        <!-- ===================== Text ===================== -->

        <Style x:Key="PaneTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        </Style>

        <Style x:Key="PaneSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,14,0,4"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
        </Style>


        <!-- ===================== Inputs ===================== -->

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource Brush.Panel.Background}"/>
            <Setter Property="Foreground"      Value="{StaticResource Brush.Text}"/>
            <Setter Property="CaretBrush"      Value="{StaticResource Brush.Text}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Control.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Selection}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ===================== Buttons ===================== -->

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.Selection}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Padding"    Value="22,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor"  Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="Padding"     Value="14,6"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ===================== Lists ===================== -->

        <Style x:Key="PlainListBox" TargetType="ListBox">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{StaticResource Brush.Text}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- Row in "Recent projects" -->
        <Style x:Key="RecentProjectItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="10,7" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selection}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card in "Templates" -->
        <Style x:Key="TemplateCard" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Width="96" Height="96" Margin="0,0,8,8" CornerRadius="4"
                                Background="{StaticResource Brush.Panel.Background}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Selection}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Geometry x:Key="Startup.TemplateIcon">M4,2 H14 L20,8 V22 H4 Z M14,2 V8 H20</Geometry>
        <Geometry x:Key="Startup.ProjectIcon">M2,5 H9 L11,7 H22 V20 H2 Z</Geometry>

    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:WindowBorder Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!-- Create (animated width) -->
                <ColumnDefinition Width="Auto"/>   <!-- divider -->
                <ColumnDefinition Width="*"/>      <!-- Open (takes the rest) -->
            </Grid.ColumnDefinitions>


            <!-- ===================================================== -->
            <!--  LEFT: New project                                    -->
            <!-- ===================================================== -->

            <!-- Split animation: the hovered side grows, the other one dims.
                 Window content is 800 wide: rest 400 | 400, active side 520 | 280.
                 Element triggers (not Style triggers), so a new animation replaces the running one. -->
            <Border x:Name="CreatePane" Grid.Column="0" Width="400" ClipToBounds="True"
                    Background="Transparent">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CreatePane" Storyboard.TargetProperty="Width"
                                                 To="520" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CreatePane" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetName="OpenPane" Storyboard.TargetProperty="Opacity"
                                                 To="0.55" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- title -->
                        <RowDefinition Height="Auto"/>  <!-- templates label -->
                        <RowDefinition Height="*"/>     <!-- templates -->
                        <RowDefinition Height="Auto"/>  <!-- inputs -->
                        <RowDefinition Height="Auto"/>  <!-- create button -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="New project" Style="{StaticResource PaneTitle}"/>
                        <TextBlock Text="Choose a template as you starting point" Style="{StaticResource PaneSubtitle}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Templates:" Style="{StaticResource FieldLabel}"/>

                    <ListBox Grid.Row="2"
                             Style="{StaticResource PlainListBox}"
                             ItemContainerStyle="{StaticResource TemplateCard}"
                             ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <Path Data="{StaticResource Startup.TemplateIcon}"
                                          Stroke="{StaticResource Brush.Text.Disabled}" StrokeThickness="1.5"
                                          Width="28" Height="28" Stretch="Uniform"
                                          HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Margin="4,8,4,0"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Named: while focus is in here, the Create side stays expanded -->
                    <StackPanel x:Name="CreateInputs" Grid.Row="3">
                        <TextBlock Text="NAME" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="LOCATION" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewProjectLocation, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="…" Margin="6,0,0,0" Padding="10,4"
                                    ToolTip="Choose folder"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseLocationCommand}"/>
                        </Grid>

                        <TextBlock Text="{Binding NewProjectPathPreview}"
                                   Margin="0,6,0,0" FontSize="11"
                                   Foreground="{StaticResource Brush.Text.Disabled}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding NewProjectPathPreview}"/>

                        <!-- Validation message; collapsed when empty -->
                        <TextBlock Text="{Binding NewProjectError}"
                                   Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Danger.Hover}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewProjectError}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NewProjectError}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Row="4" Content="Create"
                            Margin="0,18,0,0" HorizontalAlignment="Right"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CreateCommand}"/>
                </Grid>
            </Border>


            <!-- Divider -->
            <Border Grid.Column="1" Width="1" Background="{StaticResource Brush.Border}"/>


            <!-- ===================================================== -->
            <!--  RIGHT: Open project                                  -->
            <!-- ===================================================== -->

            <Border x:Name="OpenPane" Grid.Column="2" ClipToBounds="True" Background="Transparent">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CreatePane" Storyboard.TargetProperty="Width"
                                                 To="280" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CreatePane" Storyboard.TargetProperty="Opacity"
                                                 To="0.55" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetName="OpenPane" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- title -->
                        <RowDefinition Height="Auto"/>  <!-- recent label -->
                        <RowDefinition Height="*"/>     <!-- list -->
                        <RowDefinition Height="Auto"/>  <!-- browse -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Open an existing project" Style="{StaticResource PaneTitle}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="RECENT" Style="{StaticResource FieldLabel}"/>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="RecentList"
                                 Style="{StaticResource PlainListBox}"
                                 ItemContainerStyle="{StaticResource RecentProjectItem}"
                                 ItemsSource="{Binding RecentProjects}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <!-- Double-click opens the project -->
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          CommandParameter="{Binding}"/>
                                        </Grid.InputBindings>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                        <Setter Property="ToolTip" Value="Project not found"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Path Data="{StaticResource Startup.ProjectIcon}"
                                              Fill="{StaticResource Brush.Text.Disabled}"
                                              Width="18" Height="18" Stretch="Uniform"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Path}" FontSize="11"
                                                       Foreground="{StaticResource Brush.Text.Disabled}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" FontSize="11" Margin="10,0,0,0"
                                                   VerticalAlignment="Top"
                                                   Foreground="{StaticResource Brush.Text.Disabled}"
                                                   Text="{Binding LastOpened, StringFormat={}{0:d}}"/>

                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <TextBlock Text="No recent projects"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Disabled}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=RecentList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Row="3" Content="Browse…"
                            Margin="0,18,0,0" HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenExistingCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
