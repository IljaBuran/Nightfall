<UserControl x:Class="NightfallEditor.Views.MenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NightfallEditor.Views"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             MinWidth="300">

    <Menu shell:WindowChrome.IsHitTestVisibleInChrome="True">

        <!-- Project -->
        <MenuItem Header="Project">

            <MenuItem Header="Save" InputGestureText="Ctrl+S"/>
            <MenuItem Header="Save As..."/>

            <MenuItem Header="Exit"/>

        </MenuItem>

        <!-- Edit -->
        <MenuItem Header="Edit">

            <MenuItem Header="Undo" InputGestureText="Ctrl+Z"/>
            <MenuItem Header="Redo" InputGestureText="Ctrl+LShift+Z"/>

            <Separator/>

            <MenuItem Header="Settings"/>

        </MenuItem>

        <!-- View -->
        <MenuItem Header="View">
            
            <!-- Panels -->

            <MenuItem Header="Inspector"/> 
            <MenuItem Header="Hierarchy"/> 
            <MenuItem Header="Output"/> 
            
            <Separator></Separator>

            <!--  -->
            
            <MenuItem Header="Panels">

                <MenuItem Header="Recent1"/>
                <MenuItem Header="Recent2"/>
                <MenuItem Header="Recent3"/>

            </MenuItem>

        </MenuItem>

        <!-- Build -->
        <MenuItem Header="Build">
            
        </MenuItem>

    </Menu>

</UserControl>