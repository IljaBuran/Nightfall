<UserControl x:Class="NightfallEditor.Views.Toolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NightfallEditor.Views">

    <UserControl.Resources>
        <Style x:Key="TaskbarButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Geometry x:Key="PlayIcon">
            M8 5 L19 12 L8 19 Z
        </Geometry>

        <Geometry x:Key="PauseIcon">
            M6 5 H10 V19 H6 Z M14 5 H18 V19 H14 Z
        </Geometry>

        <Geometry x:Key="StopIcon">
            M6 6 H18 V18 H6 Z
        </Geometry>

    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" MinWidth="100" HorizontalAlignment="Center">

        <Button 
            Style="{StaticResource TaskbarButton}"
            ToolTip="Play">
            <Path Data="{StaticResource PlayIcon}"
                  Fill="White"
                  Width="12"
                  Height="14"
                  Stretch="Uniform"/>
        </Button>

        <Button 
            Style="{StaticResource TaskbarButton}"
            ToolTip="Pause">
            <Path Data="{StaticResource PauseIcon}"
                  Fill="White"
                  Width="12"
                  Height="14"
                  Stretch="Uniform"/>
        </Button>

        <Button 
            Style="{StaticResource TaskbarButton}"
            ToolTip="Stop">
            <Path Data="{StaticResource StopIcon}"
                  Fill="White"
                  Width="12"
                  Height="14"
                  Stretch="Uniform"/>
        </Button>


    </StackPanel>

</UserControl>
