<UserControl x:Class="NightfallEditor.Views.Toolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NightfallEditor.Views">

<StackPanel Orientation="Horizontal" MinWidth="100" HorizontalAlignment="Center">

        <Button 
            Style="{StaticResource IconButton}"
            ToolTip="Play">
            <Path Data="{StaticResource PlayIcon}"
                  Fill="{StaticResource Brush.Text}"
                  Width="12"
                  Height="14"
                  Stretch="Uniform"/>
        </Button>

        <Button 
            Style="{StaticResource IconButton}"
            ToolTip="Pause">
            <Path Data="{StaticResource PauseIcon}"
                  Fill="{StaticResource Brush.Text}"
                  Width="12"
                  Height="14"
                  Stretch="Uniform"/>
        </Button>

        <Button 
            Style="{StaticResource IconButton}"
            ToolTip="Stop">
            <Path Data="{StaticResource StopIcon}"
                  Fill="{StaticResource Brush.Text}"
                  Width="12"
                  Height="14"
                  Stretch="Uniform"/>
        </Button>


    </StackPanel>

</UserControl>
