<UserControl x:Class="NightfallEditor.Views.WindowBorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NightfallEditor.Views"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    
    <Grid Background="#252526">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Nightfall"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"
                   Foreground="White"
                   FontSize="12" />

        <Button Grid.Column="1"
                Content="&#xE921;"
                Click="OnMinimizeClicked"
                Style="{StaticResource WindowBorderButtonStyle}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>


        <Button Grid.Column="2"
                Content="&#xE922;"
                Click="OnMaximizeClicked"
                Style="{StaticResource WindowBorderButtonStyle}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

        <Button Grid.Column="3"
                Content="&#xE8BB;"
                Click="OnCloseClicked"
                Style="{StaticResource WindowBorderCloseButtonStyle}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    </Grid>
</UserControl>