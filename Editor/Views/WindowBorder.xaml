<UserControl x:Class="NightfallEditor.Views.WindowBorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NightfallEditor.Views"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    
    <Grid Background="{StaticResource Brush.Window.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"
                   Foreground="{StaticResource Brush.Text}"
                   FontSize="12" />

        <Button Grid.Column="1"
                Content="&#xE921;"
                Click="OnMinimizeClicked"
                Style="{StaticResource WindowBorderButtonStyle}"/>


        <Button Name="MaximizeButton"
                Grid.Column="2"
                Content="&#xE922;"
                Click="OnMaximizeClicked"
                Style="{StaticResource WindowBorderButtonStyle}"/>

        <Button Grid.Column="3"
                Content="&#xE8BB;"
                Click="OnCloseClicked"
                Style="{StaticResource WindowBorderCloseButtonStyle}"/>
    </Grid>
</UserControl>