<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Grays (dark to light) -->
    <Color x:Key="Color.Gray950">#1E1E1E</Color>
    <Color x:Key="Color.Gray900">#252526</Color>
    <Color x:Key="Color.Gray800">#333333</Color>
    <Color x:Key="Color.Gray700">#3E3E42</Color>
    <Color x:Key="Color.Gray600">#4A4A4F</Color>
    <Color x:Key="Color.Gray400">#6D6D6D</Color>
    <Color x:Key="Color.Gray100">#F0F0F0</Color>

    <!-- Accents -->
    <Color x:Key="Color.Blue700">#094771</Color>
    <Color x:Key="Color.Red600">#E81123</Color>
    <Color x:Key="Color.Red700">#C50F1F</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="{StaticResource Color.Gray900}"/>
    <SolidColorBrush x:Key="Brush.Panel.Background"  Color="{StaticResource Color.Gray950}"/>
    <SolidColorBrush x:Key="Brush.Popup.Background"  Color="{StaticResource Color.Gray900}"/>
    <SolidColorBrush x:Key="Brush.Border"            Color="{StaticResource Color.Gray700}"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text"              Color="{StaticResource Color.Gray100}"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled"     Color="{StaticResource Color.Gray400}"/>

    <!-- Interactive states -->
    <SolidColorBrush x:Key="Brush.Control.Hover"     Color="{StaticResource Color.Gray800}"/>
    <SolidColorBrush x:Key="Brush.Control.Pressed"   Color="{StaticResource Color.Gray600}"/>
    <SolidColorBrush x:Key="Brush.Selection"         Color="{StaticResource Color.Blue700}"/>

    <!-- Destructive actions (close button, delete…) -->
    <SolidColorBrush x:Key="Brush.Danger.Hover"      Color="{StaticResource Color.Red600}"/>
    <SolidColorBrush x:Key="Brush.Danger.Pressed"    Color="{StaticResource Color.Red700}"/>

</ResourceDictionary>