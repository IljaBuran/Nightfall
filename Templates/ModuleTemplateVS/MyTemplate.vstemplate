<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Project">
  <TemplateData>
    <Name>Nightfall Module</Name>
    <Description>Starting point for creating custom modules for Nightfall Engine</Description>
    <ProjectType>VC</ProjectType>
    <LanguageTag>cpp</LanguageTag>
    <ProjectTypeTag>library</ProjectTypeTag>
    <SortOrder>1000</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>NightfallModule</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <Icon>__TemplateIcon.png</Icon>
    <PreviewImage>__PreviewImage.png</PreviewImage>
  </TemplateData>
  <TemplateContent>
    <Project File="Module.vcxproj" TargetFileName="$safeprojectname$.vcxproj" ReplaceParameters="true">

      <Folder Name="Shared" TargetFolderName="Shared">
        <Folder Name="Module" TargetFolderName="$safeprojectname$"/>
      </Folder>

      <ProjectItem ReplaceParameters="true">Module.hpp</ProjectItem>

      <Folder Name="Private" TargetFolderName="Private">
        <ProjectItem ReplaceParameters="false">pch.hpp</ProjectItem>
        <ProjectItem ReplaceParameters="false">pch.cpp</ProjectItem>
        <ProjectItem ReplaceParameters="true">Module.cpp</ProjectItem>
      </Folder>

    </Project>
  </TemplateContent>
</VSTemplate>
